# Hoist all packages to node_modules/.pnpm for compatibility with tools that
# expect a flat node_modules layout (e.g. Jest, some ESLint plugins).
shamefully-hoist=false
strict-peer-dependencies=false
auto-install-peers=true

# Use the workspace protocol for all internal references so that pnpm resolves
# them through the local workspace rather than the npm registry.
prefer-workspace-packages=true

# Do not use the legacy node linker – keep the default pnpm linker.
node-linker=hoisted
